{
    "compilerOptions": {

        "target": "ES2020",

        "module": "ESNext",

        "moduleResolution": "Bundler",

        "lib": [
            "ES2020",
            "DOM"
        ],

        "baseUrl": ".",

        "paths": {
            "@framework/*": [
                "../vendor/cubism/Framework/src/*"
            ]
        },

        "experimentalDecorators": true,

        "esModuleInterop": true,

        "allowSyntheticDefaultImports": true,

        "skipLibCheck": true,

        "strict": false,

        "sourceMap": true
    },


    "include": [

        "src/**/*.ts",

        "../vendor/cubism/Framework/src/**/*.ts",

        "../vendor/cubism/Core/*.d.ts"
    ]
}